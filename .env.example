# Local development only. Railway uses service variables.
# Copy to .env and fill every placeholder. Never commit .env.
DATABASE_URL=inventory.db
# PostgreSQL SaaS only; use a separate schema-migration login from DATABASE_URL.
MIGRATION_DATABASE_URL=
SECRET_KEY=replace-with-a-random-secret
CSRF_SECRET=replace-with-a-different-random-secret
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-email-username
SMTP_PASSWORD=replace-with-email-app-password
FRONTEND_URL=http://localhost:8000
# Production defaults to secure HTTPS cookies. Disable only for local HTTP.
COOKIE_SECURE=false
# JSON list of exact origins (scheme + host + optional port, no path).
# Wildcards are rejected. Production defaults to the existing Railway origin.
CORS_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
# Trusted HTTP Host values (comma-separated). Set to every custom and Railway
# domain assigned to the deployed service when domains change.
TRUSTED_HOSTS=www.sparestracker.com,sparestracker.com,sparesinventory-production.up.railway.app,localhost,127.0.0.1
# PostgreSQL SaaS invitation outbox only; generate a separate key with Fernet.generate_key().
# Required when enqueueing or sending SaaS invitation mail. Keep distinct from SECRET_KEY.
MAIL_PAYLOAD_ENCRYPTION_KEY=
# Native refresh retry response cache; generate with: openssl rand -base64 32
NATIVE_REFRESH_ENCRYPTION_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
INVITATION_BASE_URL=
